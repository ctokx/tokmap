# tested: quay.io/coreos/etcd:v3.5.17 quay.io/coreos/etcd@sha256:a055da833a7c013b836ed0822e8ec1f99b059658be255ad8d0fcd31b635ae3d6
Signatures TCP HttpVersion
match http m|^HTTP/\d+\.\d+ \d+ OK\r\n.*?"etcdserver":"(\d+(?:\.\d+)*)",|s p/etcd/ v/$1/
# END quay.io/coreos/etcd

# BEGIN rabbitmq
