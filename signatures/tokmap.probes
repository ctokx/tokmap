# tokmap service probes. Generated by factory/gen_probes.py; edit that file instead.
# Signatures for these probes live in verified.matches and come from factory/.

# Printer ports print whatever they receive.
Exclude T:9100-9107

# Sends nothing, for services that speak first.
Probe TCP Empty q||
totalwaitms 6000

# RFC 9110
Probe TCP HttpRoot q|GET / HTTP/1.1\r\nHost: localhost\r\nUser-Agent: tokmap\r\nAccept: */*\r\nConnection: close\r\n\r\n|
rarity 1
ports 80,81,591,3000,4200,5000,5173,8000,8008,8080,8081,8088,8888,9000,9090
sslports 443,8443,9443

# RFC 9110
Probe TCP HttpHead q|HEAD / HTTP/1.1\r\nHost: localhost\r\nUser-Agent: tokmap\r\nAccept: */*\r\nConnection: close\r\n\r\n|
rarity 2

# RFC 9110
Probe TCP HttpOptions q|OPTIONS / HTTP/1.1\r\nHost: localhost\r\nUser-Agent: tokmap\r\nAccept: */*\r\nConnection: close\r\n\r\n|
rarity 3

# RFC 9110; error pages often name the server
Probe TCP HttpMissing q|GET /tokmap-no-such-path HTTP/1.1\r\nHost: localhost\r\nUser-Agent: tokmap\r\nAccept: */*\r\nConnection: close\r\n\r\n|
rarity 2

# version endpoint common to many services
Probe TCP HttpVersion q|GET /version HTTP/1.1\r\nHost: localhost\r\nUser-Agent: tokmap\r\nAccept: */*\r\nConnection: close\r\n\r\n|
rarity 4

